# Used by the Flyway migrate job. No real secrets in git.
# Copy to a local env file if you override defaults.
FLYWAY_URL=jdbc:postgresql://postgres:5432/drp
FLYWAY_USER=identity_app
FLYWAY_PASSWORD=change-me-identity
FLYWAY_SCHEMAS=identity
FLYWAY_TABLE=flyway_identity_history
IDENTITY_DB_NETWORK=drp-dev_default
